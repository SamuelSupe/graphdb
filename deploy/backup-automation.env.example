# HTTP credentials only. Never use the private Raft transport token here.
GRAPHDB_BACKUP_AUTOMATION_URL=http://gateway:8080
GRAPHDB_BACKUP_AUTOMATION_TENANT=production
GRAPHDB_BACKUP_AUTOMATION_TOKEN=
GRAPHDB_BACKUP_AUTOMATION_INTERVAL=86400
GRAPHDB_BACKUP_AUTOMATION_DRILL_INTERVAL=604800
# Merge with deploy/object-backup.env.example for the server's S3 configuration.
# Use one worker/state directory per endpoint and tenant; do not also enable
# that standalone tenant's built-in backup.enabled scheduler.
