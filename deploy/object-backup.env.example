# Optional backup destination; online graph storage remains local.
GRAPHDB_BACKUP_S3_BUCKET=graphdb-backups
GRAPHDB_BACKUP_S3_PREFIX=production
GRAPHDB_BACKUP_S3_REGION=us-east-1
# Leave endpoint empty for AWS S3. Set both values for MinIO/S3-compatible storage.
GRAPHDB_BACKUP_S3_ENDPOINT=
GRAPHDB_BACKUP_S3_PATH_STYLE=false
# Leave these empty to use the AWS credential chain (for example an instance role).
GRAPHDB_BACKUP_S3_ACCESS_KEY_ID=
GRAPHDB_BACKUP_S3_SECRET_ACCESS_KEY=
GRAPHDB_BACKUP_S3_SESSION_TOKEN=
